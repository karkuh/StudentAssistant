<Window x:Class="StudentAssistant.Windows.User.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Registration" Height="450" Width="600"
        WindowStartupLocation = "CenterScreen"
        Background="SlateBlue"
        Closing="Registration_OnClosing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition ></ColumnDefinition>
            <ColumnDefinition Width="3*"></ColumnDefinition>
            <ColumnDefinition ></ColumnDefinition>
        </Grid.ColumnDefinitions>

        
        <Label Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"> <Bold>Логін</Bold></Label>
        <TextBox Name="LoginTextBox" Grid.Row="1" Grid.Column="1" FontSize="13" Width="320" Height="30" VerticalAlignment="Center" ></TextBox>
        
        <Label Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"> <Bold>Пароль</Bold></Label>
        <TextBox Name="PasswordTextBox" Grid.Row="2" Grid.Column="1" FontSize="13" Width="320" Height="30" VerticalAlignment="Center"></TextBox>

        <Label Grid.Row="3" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"> <Bold>Група</Bold></Label>
        <TextBox Name="GroupTextBox" Grid.Row="3" Grid.Column="1" FontSize="13" Width="320" Height="30" VerticalAlignment="Center"></TextBox>

        

        
        
        <Button Grid.Row="0" Grid.Column="2" Content="Назад"  FontSize="14" Width="110" Height="45"
                Click="Back_Click" Background="Teal" />
        <Button Grid.Row="4" Grid.Column="1" Content="Зареєструватися"  FontSize="14" Width="130" Height="45"
                Click="Registration_Click" Background="Teal" />


    </Grid>
</Window>