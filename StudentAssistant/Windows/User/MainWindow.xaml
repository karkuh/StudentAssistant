<Window x:Class="StudentAssistant.Windows.User.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="StudentAssistant"
        MinHeight="600" MinWidth="1000" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}"
        WindowState="Maximized"
        Closing="MainWindow_OnClosing"
        Icon="pack://application:,,,/Resources/icon.ico">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="6*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="155" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Бічна панель кнопок -->
        <StackPanel Grid.Row="0" Grid.RowSpan="2" Margin="0 10 0 0">
            <Button Content="Додати предмет" Margin="0 0 0 20" Style="{StaticResource ButtonStyle}" Click="Add_subject" />
            <Button Content="Видалити предмет" Margin="0 0 0 20" Style="{StaticResource ButtonStyle}" Click="Delete_subject" />
            <Button Content="Додати завдання" Margin="0 0 0 20" Style="{StaticResource ButtonStyle}" Click="AddTask_OnClick" />
            <Button Content="Видалити завдання" Margin="0 0 0 20" Style="{StaticResource ButtonStyle}" Click="DeleteTask_OnClick" />
            <Button Content="Змінити завдання" Margin="0 0 0 20" Style="{StaticResource ButtonStyle}" Click="ChangeTask_OnClick" />
            <Button Content="Розклад" Margin="0 0 0 20" Style="{StaticResource ButtonStyle}" Click="Rozklad_OnClick" />
            <Button Content="Вийти" Style="{StaticResource ButtonStyle}" Click="Click_exit" />
        </StackPanel>

        <!-- Головна таблиця -->
        <DataGrid Grid.Row="0" Grid.Column="1" Margin="20 10" Name="DataGrid"
                  FontSize="20" IsReadOnly="True" Background="#adaed2"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  CanUserSortColumns="False" RowBackground="#adaed2"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
            <DataGrid.Resources>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="Padding" Value="0" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontStyle" Value="Italic" />
                            <Setter Property="FontSize" Value="18" />
                            <Setter Property="Background" Value="#adaed2" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="№" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Нижня панель -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="20 0 20 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Кнопка статусу та чекбокс -->
            <Button Style="{StaticResource ShowStatus}" Name="ShowStatusBackground" Margin="0 20 0 0" />

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 20 0 0">
                <CheckBox Name="ShowStatusCheckBox" FontSize="13" Click="CheckBox_OnClick"
                          Foreground="White" Padding="10 0 0 0" Content="Переглянути статус" />
            </StackPanel>

            <!-- Сітка прогресу -->
            <Grid Grid.Column="1" Name="mainGrid" Width="100" HorizontalAlignment="Right" Margin="0 0 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Background="#e45c5e" Margin="0 0 30 0" />
                <TextBlock Grid.Row="0" Text="0%" HorizontalAlignment="Right" FontWeight="SemiBold" />

                <Label Grid.Row="1" Background="#ff9d3d" Margin="0 0 30 0" />
                <TextBlock Grid.Row="1" Text="25%" HorizontalAlignment="Right" FontWeight="SemiBold" />

                <Label Grid.Row="2" Background="#e2c15f" Margin="0 0 30 0" />
                <TextBlock Grid.Row="2" Text="50%" HorizontalAlignment="Right" FontWeight="SemiBold" />

                <Label Grid.Row="3" Background="#7fd16f" Margin="0 0 30 0" />
                <TextBlock Grid.Row="3" Text="75%" HorizontalAlignment="Right" FontWeight="SemiBold" />

                <Label Grid.Row="4" Background="#3a822c" Margin="0 0 30 0" />
                <TextBlock Grid.Row="4" Text="100%" HorizontalAlignment="Right" FontWeight="SemiBold" />
            </Grid>
        </Grid>

    </Grid>

</Window>
