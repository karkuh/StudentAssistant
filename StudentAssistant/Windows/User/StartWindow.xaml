<Window x:Class="StudentAssistant.Windows.User.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="StudentAssistant" Height="500" Width="600" 
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#e2e9ff"
        Closing="StartForm_OnClosing"
        Icon="pack://application:,,,/Resources/icon.ico">
    <Window.Resources>

        <Style x:Key="TextBoxNameStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" />
                                <TextBlock x:Name="Placeholder" Text="Введіть логін" Foreground="Gray"
                                           VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextBoxPasswordStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" />
                                <TextBlock x:Name="Placeholder" Text="Введіть пароль" Foreground="Gray"
                                           VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
        </Grid.RowDefinitions>

        <Image VerticalAlignment="Bottom"
               Source="F:\GIT\StudentAssistant\StudentAssistant\Resources\logo.jpeg" />
        <TextBox Name="LoginTextBox" Grid.Row="1" Style="{StaticResource TextBoxNameStyle}"
                 VerticalAlignment="Bottom">
        </TextBox>

        <TextBox Name="PasswordTextBox" Grid.Row="2" Style="{StaticResource TextBoxPasswordStyle}"></TextBox>

        <Button  Grid.Row="3" Style="{StaticResource ShowStatus}" Name="ShowStatusBackground"
                 >

        </Button>
        <TextBlock Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="16" FontFamily="Arial" >
            <StackPanel Orientation="Horizontal">
                <CheckBox Name="SavedStudentCheckBox" Padding="10 0 0 0 " Foreground="White">Запам'ятати?</CheckBox>
            </StackPanel>
        </TextBlock>

        
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" >
            <Button  Content="Зареєструватися" Margin="0 0 20 0" Style="{StaticResource ButtonStyle}"
                     Click="SignUp_Click" />
            <Button  Content="Увійти"
                    Click="LogIn_Click" Margin="20 0 0 0" Style="{StaticResource ButtonStyle}" />

        </StackPanel>


    </Grid>
</Window>