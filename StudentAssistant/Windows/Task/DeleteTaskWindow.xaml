<Window x:Class="StudentAssistant.Windows.Task.DeleteTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="DeleteTaskWindow" 
        Height="710" Width="700"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}"
        Closing="DeleteTaskWindow_OnClosing"
        Icon="pack://application:,,,/Resources/icon.ico">
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Назва вікна -->
        <TextBlock Text="Видалення завдання" 
                   FontSize="24" FontWeight="Bold" 
                   Foreground="#4B4B77"
                   VerticalAlignment="Center"
                   Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="10"/>

        <!-- Кнопка Назад справа вгорі -->
        <Button Content="Назад" Style="{StaticResource ButtonStyle}" 
                Click="Back_OnClick"
                Grid.Row="0" Grid.Column="2"
                Margin="0,10,10,10"/>

        <!-- Роздільник -->
        <Separator Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10"/>

        <!-- Основна частина -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" Width="600">
            
            <!-- Заголовок для вибору предмету -->
            <Label FontSize="18" FontWeight="SemiBold" FontStyle="Italic"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10">
                Оберіть предмет
            </Label>

            <!-- Список предметів -->
            <ListBox Name="SubjectsListBox" Style="{StaticResource ListBoxStyle}" Height="180" Width="600"
                     SelectionChanged="SubjectsListBox_OnSelectionChanged"/>

            <!-- Заголовок для вибору завдання -->
            <Label FontSize="18" FontWeight="SemiBold" FontStyle="Italic"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,10,0,10">
                Оберіть завдання
            </Label>

            <!-- Список завдань -->
            <ListBox Name="TasksListBox" Style="{StaticResource ListBoxStyle}" Height="180" Width="600"/>

            <!-- Кнопка Видалити -->
            <Button Content="Видалити" Style="{StaticResource ButtonStyle}" 
                    Click="DeleteTask_OnClick"
                    HorizontalAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>
