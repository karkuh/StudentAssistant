<Window x:Class="StudentAssistant.Windows.Task.ChangeTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudentAssistant" Height="800" Width="900"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}"
        Closing="ChangeTaskWindow_OnClosing"
        Icon="pack://application:,,,/Resources/icon.ico">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Назва вікна -->
        <TextBlock Text="Редагування завдання"
                   FontSize="24" FontWeight="Bold"
                   Foreground="#4B4B77"
                   VerticalAlignment="Center"
                   Grid.Row="0" Grid.Column="0"
                   Margin="10"/>

        <!-- Кнопка Назад -->
        <Button Content="Назад" Style="{StaticResource ButtonStyle}"
                Click="Back_OnClick"
                Grid.Row="0" Grid.Column="1"
                Margin="0,10,10,10"/>

        <!-- Роздільник -->
        <Separator Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10"/>

        <!-- Основна частина -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Вибір предмета та завдання -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                <Label Margin="0 0 0 5" FontSize="18" FontWeight="SemiBold" FontStyle="Italic"
                       HorizontalAlignment="Center">Оберіть предмет</Label>
                <ListBox Name="SubjectsListBox" Style="{StaticResource ListBoxStyle}" Height="150" Width="370"
                         SelectionChanged="SubjectsListBox_OnSelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0">
                <Label Margin="0 0 0 5" FontSize="18" FontWeight="SemiBold" FontStyle="Italic"
                       HorizontalAlignment="Center">Оберіть завдання</Label>
                <ListBox Name="TasksListBox" Style="{StaticResource ListBoxStyle}" Height="150" Width="370"
                         SelectionChanged="TasksListBox_OnSelectionChanged"/>
            </StackPanel>

            <!-- Редагування завдання, дедлайну та статусу -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,10,0">
                <Label FontSize="18" FontWeight="SemiBold" FontStyle="Italic"
                       HorizontalAlignment="Center" Name="TaskLabel">Завдання</Label>
                <TextBox Name="TaskTextBox" Style="{StaticResource TextBoxStyle}" Height="120" Width="370"
                         TextWrapping="Wrap" AcceptsReturn="True"/>
                
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,10,0,0">
                                <Label FontSize="18" FontWeight="SemiBold" FontStyle="Italic"
                       HorizontalAlignment="Center" Name="StatusLabel">Статус</Label>
                <ListBox Name="StatusListBox" Style="{StaticResource ListBoxStyle}" Width="200"
                         SelectionChanged="StatusListBox_OnSelectionChanged" Margin="0,5">
                    <ListBoxItem>0%</ListBoxItem>
                    <ListBoxItem>25%</ListBoxItem>
                    <ListBoxItem>50%</ListBoxItem>
                    <ListBoxItem>75%</ListBoxItem>
                    <ListBoxItem>100%</ListBoxItem>
                </ListBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" >
                <Label FontSize="18" FontWeight="SemiBold" FontStyle="Italic"
                       HorizontalAlignment="Center" Name="DeadlineLabel">Дедлайн</Label>
                <DatePicker Name="DeadlineDatePicker" Style="{StaticResource DatePickerStyle}" Margin="0,0,0,10"/>

            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="1" >
                <StackPanel >
                    <Label FontSize="18" FontWeight="SemiBold" FontStyle="Italic"
                           HorizontalAlignment="Center" Name="MaxScoreLabel">Максимальна оцінка</Label>
                    <TextBox Name="MaxScoreTextBox" Style="{StaticResource TextBoxStyle}" Width="150"
                             PreviewTextInput="UIElement_OnPreviewTextInput"/>
                    <Label FontSize="18" FontWeight="SemiBold" FontStyle="Italic"
                           HorizontalAlignment="Center" Name="EarnedScoreLabel">Зароблена оцінка</Label>
                    <TextBox Name="EarnedScoreTextBox" Style="{StaticResource TextBoxStyle}" Width="150"
                             PreviewTextInput="UIElement_OnPreviewTextInput"/>
                </StackPanel>
                <StackPanel>
                    
                </StackPanel>
            </StackPanel>
            
           
        </Grid>

        <!-- Кнопка Змінити -->
        <Button Content="Змінити" Style="{StaticResource ButtonStyle}"
                Click="ChangeButton_OnClick"
                Grid.Row="3" Grid.ColumnSpan="2"
                HorizontalAlignment="Center" Margin="0 20"/>
    </Grid>
</Window>
