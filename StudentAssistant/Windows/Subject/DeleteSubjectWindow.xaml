<Window x:Class="StudentAssistant.Windows.Subject.DeleteSubjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudentAssistant" Height="450" Width="700"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}"
        Closing="DeleteSubject_OnClosing"
        Icon="pack://application:,,,/Resources/icon.ico">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Назва вікна -->
        <TextBlock Text="Видалення предмету" 
                   FontSize="24" FontWeight="Bold" 
                   Foreground="#4B4B77"
                   VerticalAlignment="Center"
                   Grid.Row="0" Grid.Column="0"
                   Margin="10"/>

        <!-- Кнопка Назад справа вгорі -->
        <Button Content="Назад" Style="{StaticResource ButtonStyle}" 
                Click="Back_OnClick"
                Grid.Row="0" Grid.Column="1"
                Margin="0,10,10,10"/>

        <!-- Роздільник -->
        <Separator Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10"/>

        <!-- Основна частина -->
        <StackPanel   Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Width="600">
            
            <Label Margin="0 0 0 5" FontSize="18" FontWeight="SemiBold" FontStyle="Italic"
                   VerticalAlignment="Center" HorizontalAlignment="Center">
                Оберіть предмет
            </Label>

            <ListBox Name="SubjectsListBox" Style="{StaticResource ListBoxStyle}" Height="180" Width="600"/>
        </StackPanel>

        <!-- Кнопка Видалити -->
        <Button Content="Видалити" Style="{StaticResource ButtonStyle}" 
                Click="OK_OnClick"
                Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0 20 0 0"/>
    </Grid>
</Window>
