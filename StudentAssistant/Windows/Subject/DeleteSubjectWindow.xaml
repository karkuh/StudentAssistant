<Window x:Class="StudentAssistant.Windows.Subject.DeleteSubjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="StudentAssistant"  Height="450" Width="800"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#e2e9ff"
        Closing="DeleteSubject_OnClosing"
        Icon="pack://application:,,,/Resources/icon.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="3*"></RowDefinition>
            <RowDefinition></RowDefinition>


        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Button Grid.Row="0" Grid.Column="2" Content="Назад" Style="{StaticResource ButtonStyle}" Click="Back_OnClick"></Button>
        <Label Grid.Row="1" Grid.Column="1" Margin="0 0 0 0" FontSize="18" FontWeight="SemiBold" FontStyle="Italic"
               VerticalAlignment="Center" HorizontalAlignment="Center">
            Оберіть предмет
        </Label>

        <ListBox Grid.Row="2" Grid.Column="1" Name="SubjectsListBox" Style="{StaticResource ListBoxStyle}"></ListBox>

        <Button Grid.Row="3" Grid.Column="1" Content="Видалити" Style="{StaticResource ButtonStyle}" Click="OK_OnClick"></Button>
    </Grid>
</Window>