<Window x:Class="StudentAssistant.Views.Subject.RozkladWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StudentAssistant.Views.Subject"
        Title="StudentAssistant"
        Height="450" Width="800" MinHeight="450" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BackgroundColor}"
        Closing="RozkladWindow_OnClosing"
        Icon="pack://application:,,,/Resources/icon.ico">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Розклад занять" 
                       FontSize="24" FontWeight="Bold"
                       Foreground="#4B4B77"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>

            <Button Grid.Column="1" Content="Назад" 
                    Style="{StaticResource ButtonStyle}" 
                    Click="Back_OnClick"
                    Margin="0,0,0,10"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,20">
            <ComboBox x:Name="comboBox"
                      Width="200" Margin="0,0,20,0"
                      VerticalAlignment="Center"
                      Style="{StaticResource ComboboxStyle}"
                      IsEditable="True"
                      IsTextSearchEnabled="True"/>

            <Button Content="OK"
                    Style="{StaticResource ButtonStyle}"
                    Click="ButtonBase_OnClick"
                    IsDefault="True"/>
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,10"/>

        <TabControl Grid.Row="3"
                    FontWeight="SemiBold"
                    FontSize="18"
                    Background="{StaticResource BackgroundColor}"
                    Margin="0,10,0,0">
            <TabItem Header="Перший тиждень" Style="{StaticResource TabItemStyle}">
                <DataGrid x:Name="dataGridFirstWeek"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="#adaed2"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          RowBackground="#adaed2"
                          AlternatingRowBackground="#9997de"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                          CellStyle="{StaticResource DataGridCellStyle}"
                          Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="" Binding="{Binding TimeSlot}"/>
                        <DataGridTextColumn Header="Понеділок" Binding="{Binding Monday}"/>
                        <DataGridTextColumn Header="Вівторок" Binding="{Binding Tuesday}"/>
                        <DataGridTextColumn Header="Середа" Binding="{Binding Wednesday}"/>
                        <DataGridTextColumn Header="Четвер" Binding="{Binding Thursday}"/>
                        <DataGridTextColumn Header="П'ятниця" Binding="{Binding Friday}"/>
                        <DataGridTextColumn Header="Субота" Binding="{Binding Saturday}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Другий тиждень" Style="{StaticResource TabItemStyle}">
                <DataGrid x:Name="dataGridSecondWeek"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="#adaed2"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          RowBackground="#adaed2"
                          AlternatingRowBackground="#9997de"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                          CellStyle="{StaticResource DataGridCellStyle}"
                          Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="" Binding="{Binding TimeSlot}"/>
                        <DataGridTextColumn Header="Понеділок" Binding="{Binding Monday}"/>
                        <DataGridTextColumn Header="Вівторок" Binding="{Binding Tuesday}"/>
                        <DataGridTextColumn Header="Середа" Binding="{Binding Wednesday}"/>
                        <DataGridTextColumn Header="Четвер" Binding="{Binding Thursday}"/>
                        <DataGridTextColumn Header="П'ятниця" Binding="{Binding Friday}"/>
                        <DataGridTextColumn Header="Субота" Binding="{Binding Saturday}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
