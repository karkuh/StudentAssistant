<Window x:Class="StudentAssistant.Views.Subject.AddSubjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudentAssistant" Height="450" Width="700"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}"
        Closing="AddSubjectWindow_OnClosing"
        Icon="pack://application:,,,/Resources/icon.ico">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Додавання предмету" 
                   FontSize="24" FontWeight="Bold" 
                   Foreground="#4B4B77"
                   VerticalAlignment="Center"
                   Grid.Row="0" Grid.Column="0"
                   Margin="10"/>

        <Button Content="Назад" Style="{StaticResource ButtonStyle}" 
                Click="Back_OnClick"
                Grid.Row="0" Grid.Column="1"
                Margin="0,10,10,10"/>

        <Separator Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
            
            <Label Margin="0 0 0 5" FontSize="18" FontWeight="SemiBold" FontStyle="Italic">
                Викладач
            </Label>
            <ComboBox Name="TeacherComboBox" Style="{StaticResource ComboboxStyle}" 
                      VerticalAlignment="Center" IsReadOnly="True" Margin="0,0,0,15"/>

            <Label Margin="0 0 0 5" FontSize="18" FontWeight="SemiBold" FontStyle="Italic">
                Предмет
            </Label>
            <ComboBox Name="SubjectComboBox" Style="{StaticResource ComboboxStyle}" 
                      VerticalAlignment="Center" IsReadOnly="True" />
        </StackPanel>

        <Button Content="Додати" Style="{StaticResource ButtonStyle}" 
                Click="Add_OnClick"
                Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0 20 0 0"/>
    </Grid>
</Window>
