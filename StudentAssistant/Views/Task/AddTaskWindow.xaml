<Window x:Class="StudentAssistant.Views.Task.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudentAssistant" Height="650" Width="900"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}"
        Closing="AddTaskWindow_OnClosing"
        Icon="pack://application:,,,/Resources/icon.ico">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Додавання завдання" 
                   FontSize="24" FontWeight="Bold" 
                   Foreground="#4B4B77"
                   VerticalAlignment="Center"
                   Grid.Row="0" Grid.Column="0"
                   Margin="10"/>

        <Button Content="Назад" Style="{StaticResource ButtonStyle}" 
                Click="Back_OnClick"
                Grid.Row="0" Grid.Column="1"
                Margin="0,10,10,10"/>

        <Separator Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10"/>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition   />
                <ColumnDefinition  />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Top">
                <Label Margin="0 0 0 5" FontSize="18" FontWeight="SemiBold" FontStyle="Italic"
                       VerticalAlignment="Center" HorizontalAlignment="Center">
                    Оберіть предмет
                </Label>
                
                <ListBox Name="SubjectsListBox" Style="{StaticResource ListBoxStyle}" Height="260" Width="370"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top">
                <Label Margin="0 0 0 5" FontSize="18" FontWeight="SemiBold" FontStyle="Italic"
                       VerticalAlignment="Center" HorizontalAlignment="Center">
                    Введіть завдання
                </Label>
                <TextBox Name="TaskTextBox" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource TextBoxStyle}" Height="260" Width="370"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Top">
               
                <Label Margin="0 0 0 5" FontSize="18" FontWeight="SemiBold" FontStyle="Italic"
                       VerticalAlignment="Center" HorizontalAlignment="Center">
                    Оберіть дедлайн
                </Label>
                <DatePicker Name="DeadLineDatePicker" Style="{StaticResource DatePickerStyle}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top">
                
                <Label Margin="0 0 0 5" FontSize="18" FontWeight="SemiBold" FontStyle="Italic"
                       VerticalAlignment="Center" HorizontalAlignment="Center">
                    Введіть максимальну оцінку
                </Label>
                <DockPanel VerticalAlignment="Center" Margin="10">
                    <TextBox
                        Text="{Binding ElementName=MaxScoreSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}"
                        DockPanel.Dock="Right" TextAlignment="Right" Width="40" />
                    <Slider Maximum="100" TickPlacement="BottomRight" TickFrequency="1" IsSnapToTickEnabled="True" 
                            Name="MaxScoreSlider" Width="300" />
                </DockPanel>
            </StackPanel>
        </Grid>
        <Button Content="Додати" Style="{StaticResource ButtonStyle}" 
                Click="Add_OnClick"
                Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0 0 0 20"/>
    </Grid>
</Window>
