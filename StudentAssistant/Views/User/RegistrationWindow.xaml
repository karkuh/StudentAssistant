<Window x:Class="StudentAssistant.Views.User.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudentAssistant"
        Height="450" Width="670"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}"
        Closing="Registration_OnClosing"
        Icon="pack://application:,,,/Resources/icon.ico"
        Loaded="Window_Loaded">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Реєстрація користувача"
                   FontSize="24" FontWeight="Bold"
                   Foreground="#4B4B77"
                   VerticalAlignment="Center"
                   Grid.Row="0" Grid.Column="0"
                   Margin="10" />

        <Button Content="Назад" Style="{StaticResource ButtonStyle}"
                Click="Back_Click"
                Grid.Row="0" Grid.Column="1"
                Margin="0,10,10,10" />

        <Separator Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0" Margin="0,10" />

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Grid.Column="0"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="400">

            <StackPanel Orientation="Horizontal" Margin="0 0 0 30">
                <Label FontSize="18" FontStyle="Italic" FontWeight="SemiBold" Width="100">
                    Логін
                </Label>
                <TextBox Name="LoginTextBox" Style="{StaticResource TextBoxStyle}" />
            </StackPanel>


            <StackPanel Orientation="Horizontal" Margin="0 0 0 30">
                <Label FontSize="18" FontStyle="Italic" FontWeight="SemiBold" Width="100">
                    Пароль
                </Label>
                <TextBox Name="PasswordTextBox" Style="{StaticResource TextBoxStyle}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" >
                <Label FontSize="18" FontStyle="Italic" FontWeight="SemiBold" Width="100">
                    Група
                </Label>
                <ComboBox x:Name="GroupComboBox" Style="{StaticResource ComboboxStyle}"
                          Height="40" Width="250" IsTextSearchEnabled="True"
                          IsEditable="True" />
            </StackPanel>


        </StackPanel>

        <Button Content="Зареєструватися" Style="{StaticResource ButtonStyle}"
                Click="Registration_Click"
                Grid.Row="3" Grid.ColumnSpan="2"
                HorizontalAlignment="Center" Margin="0 20 0 0" />
    </Grid>
</Window>